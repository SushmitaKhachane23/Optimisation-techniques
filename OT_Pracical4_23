      "source": [
        "import sympy as sp\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "x,y,lam = sp.symbols('x y lam')\n"
      ],
      "metadata": {
        "id": "D9WlJTICmn-f"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#$objective function\n",
        "f = x * y\n",
        "\n",
        "# constraint function\n",
        "g = x + y - 10"
      ],
      "metadata": {
        "id": "zW5OpIVtmuU_"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# lagrangian function\n",
        "L = f + lam * g"
      ],
      "metadata": {
        "id": "1k2C5yFom2Ev"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#partial derivative\n",
        "eq1 = sp.diff(L,x)\n",
        "eq2 = sp.diff(L,y)\n",
        "eq3 = sp.diff(L,lam)"
      ],
      "metadata": {
        "id": "BIUL9VEHnCUh"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "solution = sp.solve((eq1, eq2, eq3), (x, y, lam))\n",
        "print(\"Optimal Solution:\")\n",
        "print(solution)\n"
      ],
      "metadata": {
