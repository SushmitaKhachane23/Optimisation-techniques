        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Optimal Solution:\n",
            "{lam: -5, x: 5, y: 5}\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Objective function value\n",
        "x_val = solution[x]\n",
        "y_val = solution[y]\n",
        "optimal_value = f.subs({x: x_val, y: y_val})\n",
        "\n",
        "print(\"\\nMaximum Value of Objective Function:\")\n",
        "\n",
        "print(optimal_value)"
      ],
